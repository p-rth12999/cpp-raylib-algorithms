{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Main",
            "type": "shell",
            "command": "C:/mingw64/bin/g++.exe",
            "args": [
                "main.cpp",
                "algorithms/dda.cpp",
                "algorithms/bresenham_line.cpp",
                "-o", "main.exe",
                "-I", "include",
                "-I", "algorithms",
                "-L", "lib",
                "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Assignment 1 - DDA",
            "type": "shell",
            "command": "C:/mingw64/bin/g++.exe",
            "args": [
                "assignments/assignment1_dda.cpp",
                "-o", "assignments/assignment1_dda.exe",
                "-I", "include",
                "-L", "lib",
                "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
