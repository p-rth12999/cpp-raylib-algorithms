{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Current File",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/run.ps1",
                "${file}"
            ],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "clear": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Current File",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/run.ps1",
                "${file}",
                "-BuildOnly"
            ],
            "group": "build",
            "presentation": { "reveal": "always", "clear": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}