{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Current File",
            "type": "shell",
            "command": "C:/mingw64/bin/g++.exe \"${file}\" -o \"bin/${fileBasenameNoExtension}.exe\" -I include -I algorithms -L lib -lraylib -lopengl32 -lgdi32 -lwinmm; if ($LASTEXITCODE -eq 0) { & \"bin/${fileBasenameNoExtension}.exe\" }",
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "clear": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Current File",
            "type": "shell",
            "command": "C:/mingw64/bin/g++.exe",
            "args": [
                "${file}",
                "-o", "bin/${fileBasenameNoExtension}.exe",
                "-I", "include",
                "-I", "algorithms",
                "-L", "lib",
                "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run Main",
            "type": "shell",
            "command": "C:/mingw64/bin/g++.exe main.cpp algorithms/dda.cpp algorithms/bresenham_line.cpp algorithms/bresenham_circle.cpp -o bin/main.exe -I include -I algorithms -L lib -lraylib -lopengl32 -lgdi32 -lwinmm; if ($LASTEXITCODE -eq 0) { & \"bin/main.exe\" }",
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}